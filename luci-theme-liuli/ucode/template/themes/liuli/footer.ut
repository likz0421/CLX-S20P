{#
	琉璃 Liuli — LuCI glassmorphism theme
	Page footer: closes the shell, renders LuCI bootstrap.
-#}

				</div><!-- /#maincontent -->
				<footer class="liuli-footer">
					<span>琉璃 Liuli Theme v1.0</span>
					<span class="sep">·</span>
					<a class="luci-link" href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">Powered by {{ version?.luciname ?? 'LuCI' }} ({{ version?.luciversion ?? '' }})</a>
					{% if (version?.distname): %}
					<span class="sep">·</span>
					<a class="luci-link" href="{{ version.disturl ?? '#' }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion ?? '' }}{{ version.distrevision ? `-${version.distrevision}` : '' }}</a>
					{% endif %}
				</footer>
			</main>
		</div><!-- /.liuli-main -->
	</div><!-- /.liuli-app -->

	<ul id="modemenu" style="display:none"></ul>

	{% include('themes/' + theme + '/page_scripts', { is_login: false }) %}
</body>
</html>
