config theme 'main'
	# 配色方案: aurora|ocean|sunset|forest|graphite|custom
	option scheme 'aurora'
	option primary '#5b7cfa'
	option primary2 '#8b5cf6'
	# 背景自定义
	option bg_image ''
	option bg_dim '0'
	option login_bg ''
	# 外观微调
	option blur '22'
	option radius '18'
	option blobs '1'
	option glass '62'
	# 夜间模式: auto|light|dark
	option dark 'auto'
	option dark_start '19'
	option dark_end '7'
	# 顶栏: 1 显示 / 0 隐藏
	option chips '1'
