{
	"luci-theme-liuli": {
		"description": "Grant access to Liuli theme settings",
		"read": {
			"uci": [ "liuli" ]
		},
		"write": {
			"uci": [ "liuli" ],
			"file": {
				"/www/luci-static/liuli/liuli-bg": [ "write", "remove" ],
				"/www/luci-static/liuli/liuli-login-bg": [ "write", "remove" ]
			}
		}
	},
	"luci.liuli-theme": {
		"description": "Grant access to Liuli theme config import/export",
		"read": {
			"ubus": {
				"luci.liuli-theme": [ "getConfig" ]
			}
		},
		"write": {
			"ubus": {
				"luci.liuli-theme": [ "setConfig" ]
			}
		}
	},
	"luci.liuli": {
		"description": "Grant theme page access to background manager",
		"read": {
			"ubus": {
				"luci.liuli": [ "bgList", "bgRemove", "bgRename" ]
			}
		},
		"write": {
			"ubus": {
				"luci.liuli": [ "bgRemove", "bgRename" ]
			}
		}
	}
}
